{
  "id": "/",
  "name": "Plotline: Track & Find Trends",
  "short_name": "Plotline",
  "description": "Track habits and symptoms, then find which ones actually affect how you feel.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "health",
    "lifestyle",
    "productivity",
    "utilities"
  ],
  "background_color": "#f4f6fb",
  "theme_color": "#161c30",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
